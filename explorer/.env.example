BIND_ADDRESS=127.0.0.1:3001
BITCOIN_RPC_URL=http://127.0.0.1:18443
BITCOIN_RPC_USER=bitcoin
BITCOIN_RPC_PASSWORD=bitcoin

# For BitRPC, use:
# BITCOIN_RPC_URL=https://bitrpc.thebuidl.xyz/bitcoin
# BITCOIN_RPC_API_KEY=replace_with_your_key

# Optional testnet support. If these are unset, /api/*?network=testnet returns
# a clear "testnet is not configured" error while mainnet keeps working.
# BITCOIN_TESTNET_RPC_URL=https://your-testnet-rpc.example/bitcoin
# BITCOIN_TESTNET_RPC_USER=bitcoin
# BITCOIN_TESTNET_RPC_PASSWORD=bitcoin
# BITCOIN_TESTNET_RPC_API_KEY=replace_with_your_testnet_key

# Address balances and history need an address-indexing provider: the node RPC
# has no address index, and scantxoutset is blocked by most hosted providers.
# Without this key /api/address reports the limitation; everything else works.
TATUM_API_KEY=replace_with_your_tatum_key
# TATUM_BASE_URL=https://api.tatum.io
# Optional indexed provider for testnet address/history fallback.
# TATUM_TESTNET_API_KEY=replace_with_your_testnet_tatum_key
# TATUM_TESTNET_BASE_URL=https://api.tatum.io
# Cache Tatum/indexer responses in memory so repeated demo traffic does not
# burn provider credits. Expired cache entries are still used if Tatum fails.
# TATUM_CACHE_TTL_SECONDS=300

# Optional persistent cache. When set, Tatum/indexer responses survive restarts
# and redeploys. If unavailable, the API falls back to in-memory caching.
# DATABASE_URL=postgres://user:password@localhost:5432/bitscan
